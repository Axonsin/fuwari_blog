---
import { aboutHero } from "@/data/media/about-hero";
import { url } from "@/utils/url-utils";

const clientMetadata = {
	...aboutHero,
	poster: { ...aboutHero.poster, src: url(aboutHero.poster.src) },
	renditions: aboutHero.renditions.map((rendition) => ({
		...rendition,
		src: url(rendition.src),
	})),
};
---

<div
	id="about-hero"
	class="about-hero"
	data-about-hero={JSON.stringify(clientMetadata)}
	style={`--about-hero-height: ${aboutHero.presentation.heroHeightVh}vh`}
	aria-label="About page background video"
>
	<img
		class="about-hero__poster"
		src={url(aboutHero.poster.src)}
		width={aboutHero.poster.width}
		height={aboutHero.poster.height}
		alt=""
		fetchpriority="high"
		decoding="async"
	/>
	<video
		class="about-hero__video"
		preload={aboutHero.playback.preload}
		muted
		playsinline
		loop
		disablepictureinpicture
		disableRemotePlayback
		aria-hidden="true"
	></video>
	<canvas class="about-hero__canvas" aria-hidden="true"></canvas>
	<div class="about-hero__buffer" aria-hidden="true">
		<div class="about-hero__buffer-value"></div>
	</div>
	<div class="about-hero__credit" aria-label={`Video credit: ${aboutHero.presentation.credit}`}>
		<span aria-hidden="true">©</span>
		<span>{aboutHero.presentation.credit}</span>
	</div>
</div>

<style>
	.about-hero {
		position: relative;
		width: 100%;
		height: var(--about-hero-height);
		overflow: hidden;
		background: #090d16;
		isolation: isolate;
		will-change: opacity;
	}

	.about-hero__poster,
	.about-hero__video,
	.about-hero__canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.about-hero__poster,
	.about-hero__video {
		transform: scale(var(--about-hero-css-scale, 1));
		filter: blur(var(--about-hero-css-blur, 0px));
		transition: opacity 420ms ease;
		will-change: filter, transform, opacity;
	}

	.about-hero__video,
	.about-hero__canvas {
		opacity: 0;
	}

	.about-hero.is-canvas-ready .about-hero__canvas,
	.about-hero.is-video-fallback .about-hero__video {
		opacity: 1;
	}

	.about-hero.is-canvas-ready .about-hero__poster,
	.about-hero.is-video-fallback .about-hero__poster {
		opacity: 0;
	}

	.about-hero__canvas {
		display: block;
	}

	.about-hero__buffer {
		position: absolute;
		z-index: 3;
		left: 0;
		right: 0;
		bottom: 0;
		height: 2px;
		background: rgb(255 255 255 / 12%);
		transition: opacity 300ms ease;
	}

	.about-hero.is-playing .about-hero__buffer,
	.about-hero.is-poster-only .about-hero__buffer,
	.about-hero.is-error .about-hero__buffer {
		opacity: 0;
	}

	.about-hero__buffer-value {
		width: 0;
		height: 100%;
		background: rgb(255 255 255 / 78%);
		box-shadow: 0 0 8px rgb(255 255 255 / 45%);
		transition: width 160ms linear;
	}

	.about-hero__credit {
		position: absolute;
		z-index: 4;
		right: max(1rem, env(safe-area-inset-right));
		bottom: 4.25rem;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		max-width: calc(100% - 2rem);
		padding: 0.55rem 0.85rem;
		border: 1px solid rgb(255 255 255 / 12%);
		border-radius: 999px;
		background: rgb(0 0 0 / 55%);
		box-shadow: 0 0.4rem 1.5rem rgb(0 0 0 / 18%);
		color: rgb(255 255 255 / 78%);
		font-size: 0.75rem;
		line-height: 1;
		backdrop-filter: blur(8px);
	}

	@media (max-width: 640px) {
		.about-hero__credit {
			right: 0.75rem;
			bottom: 4rem;
			font-size: 0.6875rem;
		}
	}
</style>
